{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@regbridge/db": ["../db/src"]
    }
  },
  "composite": true,
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/test-*.ts"]
}

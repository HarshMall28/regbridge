{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regbridge",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "services": [
    {
      "binding": "API",
      "service": "regbridge-api",
    },
  ],
}
